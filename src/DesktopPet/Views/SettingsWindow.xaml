<Window x:Class="DesktopPet.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet 设置" Width="480" Height="620" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F4F6F5" FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="#243C36">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#64766F" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="26,22">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="DesktopPet" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="设置你的桌面陪伴" Style="{StaticResource Hint}" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock Text="0.1.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#6B8279" />
        </Grid>
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="SaveStatus" Text="修改后立即生效，自动保存" VerticalAlignment="Center"
                       Style="{StaticResource Hint}" MaxWidth="270" HorizontalAlignment="Left" />
            <Button Content="完成" HorizontalAlignment="Right" Width="78" Height="32"
                    Click="OnDone" IsCancel="True" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" CornerRadius="10" Padding="18,12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="显示与行为" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <CheckBox x:Name="TopmostCheck" Content="始终置顶"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <CheckBox x:Name="AutoBehaviorCheck" Content="开启自动行为"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <CheckBox x:Name="ShowOnStartupCheck" Content="启动应用时显示宠物"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <TextBlock Text="关闭自动行为后，仍可点击和拖动。隐藏后可从系统托盘重新显示。"
                                   Style="{StaticResource Hint}" Margin="0,6,0,3" />
                        <Separator Margin="0,12,0,8" />
                        <TextBlock Text="动画" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <CheckBox x:Name="EnableAnimationsCheck" Content="启用序列帧动画"
                                  Checked="OnControlChanged" Unchecked="OnControlChanged" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
                            <TextBlock Text="动画速度" VerticalAlignment="Center" />
                            <ComboBox x:Name="AnimationSpeedCombo" Grid.Column="1" SelectionChanged="OnSelectionChanged"
                                      AutomationProperties.Name="动画速度">
                                <ComboBoxItem Content="慢（0.75x）" />
                                <ComboBoxItem Content="正常（1x）" />
                                <ComboBoxItem Content="快（1.5x）" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="关闭后保留静态图、点击反馈和自动移动；缺少帧时会自动使用默认图片。"
                                   Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="宠物大小" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScaleLabel" Text="100%" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="ScaleSlider" Minimum="80" Maximum="200" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="20"
                                AutomationProperties.Name="宠物大小百分比"
                                ValueChanged="OnScaleChanged" />
                        <Grid Margin="0,2,0,18">
                            <TextBlock Text="80%" Style="{StaticResource Hint}" />
                            <TextBlock Text="200%" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
                            <TextBlock Text="移动速度" VerticalAlignment="Center" />
                            <ComboBox x:Name="SpeedCombo" Grid.Column="1" SelectionChanged="OnSelectionChanged"
                                      AutomationProperties.Name="移动速度">
                                <ComboBoxItem Content="慢" />
                                <ComboBoxItem Content="正常" />
                                <ComboBoxItem Content="快" />
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
                            <TextBlock Text="行为频率" VerticalAlignment="Center" />
                            <ComboBox x:Name="FrequencyCombo" Grid.Column="1" SelectionChanged="OnSelectionChanged"
                                      AutomationProperties.Name="行为频率">
                                <ComboBoxItem Content="低" />
                                <ComboBoxItem Content="正常" />
                                <ComboBoxItem Content="高" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="默认大小约 160 像素；Windows 显示缩放会影响实际像素大小。"
                                   Style="{StaticResource Hint}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
